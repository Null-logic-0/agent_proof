# Copy to .env and uncomment what you have. Everything is optional: without
# these, AgentProof uses PayPal.Demo, and Ollama at its default address.
# Keep a variable commented out rather than empty: an empty value still
# counts as set.

# PayPal Sandbox REST app (developer.paypal.com → Apps & Credentials)
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=

# Local Ollama (these are the defaults)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional OpenAI provider; AI_PROVIDER=openai makes it the default
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# AI_PROVIDER=openai
