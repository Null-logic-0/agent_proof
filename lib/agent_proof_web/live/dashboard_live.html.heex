<Layouts.app {assigns}>
  <div class="mb-8">
    <h1 class="text-2xl font-semibold tracking-tight">Agent authorizations</h1>
    <p class="mt-1 text-sm text-base-content/70">
      Give an AI agent a spending limit, let it shop, and keep a provable record of every step.
    </p>
  </div>

  <.demo_scenario_card :if={@demo_mode} />

  <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[22rem_minmax(0,1fr)]">
    <section class="card border border-base-300 bg-base-100 shadow-sm lg:sticky lg:top-6">
      <div class="card-body">
        <h2 class="card-title text-base">Authorize an agent</h2>
        <p class="text-sm text-base-content/70">What the customer allows the agent to buy.</p>

        <.grant_form form={@form} />
      </div>
    </section>

    <div>
      <.async_result assign={@listing}>
        <:loading>
          <.loading_state id="authorizations-loading" rows={3} />
        </:loading>

        <:failed :let={_failure}>
          <.error_state
            id="authorizations-error"
            title="Couldn't load your agents"
            message="Something went wrong on our side. Your agents and their records are safe; please try again."
            retry="retry_load"
          />
        </:failed>

        <section
          id="authorizations"
          phx-update="stream"
          phx-viewport-bottom={@more? && !@loading_more && "load_more"}
          class="space-y-4"
        >
          <%!-- Visible only while it is the list's only child, so it updates itself as bots are added or deleted. --%>
          <.empty_state
            id="authorizations-empty"
            class="hidden only:flex"
            icon="hero-cpu-chip"
            title="No authorized agents yet"
            message="Authorize one to let it start shopping."
          />

          <.authorization_card
            :for={{dom_id, card} <- @streams.authorizations}
            id={dom_id}
            card={card}
          />
        </section>

        <div class="mt-4 space-y-4">
          <.loading_state :if={@loading_more} id="authorizations-loading-more" rows={2} />
          <div :if={@more? && !@loading_more} class="flex justify-center">
            <button
              id="load-more"
              type="button"
              class="btn btn-sm btn-ghost"
              phx-click="load_more"
            >
              <.icon name="hero-chevron-down" class="size-4" /> Load more
            </button>
          </div>
        </div>
      </.async_result>
    </div>
  </div>

  <.edit_agent_modal :if={@edit_form} form={@edit_form} card={@editing} />

  <%!-- Product suggestions for every card's search box. --%>
  <datalist id="catalog-products">
    <option :for={name <- @product_names} value={name} />
  </datalist>
</Layouts.app>
